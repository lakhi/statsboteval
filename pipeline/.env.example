# Copy to .env (git-ignored) and fill in. Run the pipeline from pipeline/.
# The repo is public — this file holds placeholders only, never real values.

# --- Production StatsBot MySQL (Uni Wien VPN required) --------------------------
# The DB is LIVE and strictly read-only for this project (CLAUDE.md constraint 5).
STATSBOT_DB_HOST=example.mysql.example.ac.at
STATSBOT_DB_PORT=3306
STATSBOT_DB_NAME=example
STATSBOT_DB_USER=example
STATSBOT_DB_PASSWORD=changeme

# --- Program-level roster CSV (D-39) --------------------------------------------
# uid-keyed `uid,status,ma_start_semester,source` file produced by the roster
# derivation. Lives OUTSIDE the repo tree beside its source Excel lists
# (docs/ethics/data-handling.md, program-level section); uids are HMAC'd in
# flight at import and never stored.
STUDENT_STATUS_CSV="/path/to/bachelor-master-records/student_status.csv"

# --- Bergmann materials (git-ignored local files; D-16/D-30) --------------------
# Directory holding wrapper.txt, categories.md, method_themes.txt,
# software_themes.txt — materialized by the operator from the local Bergmann docs
# (Declarative Statement from manuscript Table 1) and the public Stage-2 theme
# lists. Contents must never be committed; keep it outside the repo or under a
# git-ignored path (see .gitignore's bergmann-materials/ guard).
BERGMANN_PROMPTS_DIR=/path/to/bergmann-materials

# --- Azure OpenAI classifier (EU Data Zone Standard, Sweden Central; D-30/D-34) --
# Chat text is sent transiently for classification (consented practice) and never
# persisted cloud-side. Key-first auth: the operator lacks roleAssignments/write
# in MOPS, so managed-identity/RBAC is unavailable (D-31).
AZURE_OPENAI_ENDPOINT=https://example.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_API_KEY=changeme

# --- Pseudonymization pepper (D-05/D-34) ----------------------------------------
# Generate once:  python -c "import secrets; print(secrets.token_hex(32))"
# Keep a backup copy in the owner's password manager (no pepper => no erasure).
# Rotation forces a full re-ingest; the corpus fingerprint interlock refuses a
# mismatched pepper.
PSEUDONYM_PEPPER=changeme
