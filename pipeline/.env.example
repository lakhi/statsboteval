# Copy to .env (git-ignored) and fill in. Run the pipeline from pipeline/.
# The repo is public — this file holds placeholders only, never real values.

# --- Production StatsBot MySQL (Uni Wien VPN required) --------------------------
# The DB is LIVE and strictly read-only for this project (CLAUDE.md constraint 5).
STATSBOT_DB_HOST=example.mysql.example.ac.at
STATSBOT_DB_PORT=3306
STATSBOT_DB_NAME=example
STATSBOT_DB_USER=example
STATSBOT_DB_PASSWORD=changeme

# --- Pseudonymization pepper (D-05/D-34) ----------------------------------------
# Generate once:  python -c "import secrets; print(secrets.token_hex(32))"
# Keep a backup copy in the owner's password manager (no pepper => no erasure).
# Rotation forces a full re-ingest; the corpus fingerprint interlock refuses a
# mismatched pepper.
PSEUDONYM_PEPPER=changeme
