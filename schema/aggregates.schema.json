          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "label",
        "coverage"
      ],
      "title": "AllTimeWindow",
      "type": "object"
    },
    "Coverage": {
      "properties": {
        "from": {
          "pattern": "^\\d{4}-W\\d{2}$",
          "title": "From",
          "type": "string"
        },
        "through": {
          "pattern": "^\\d{4}-W\\d{2}$",
          "title": "Through",
          "type": "string"
        }
      },
      "required": [
        "from",
        "through"
      ],
      "title": "Coverage",
      "type": "object"
    },
    "Footnote": {
