          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "Footnote",
      "type": "object"
    },
    "HeatmapCell": {
      "properties": {
        "cell": {
          "discriminator": {
            "mapping": {
              "ok": "#/$defs/OkCell",
              "suppressed": "#/$defs/SuppressedCell"
