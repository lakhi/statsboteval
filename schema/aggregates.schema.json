  "$id": "https://raw.githubusercontent.com/lakhi/statsboteval/main/schema/aggregates.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Root of the aggregates file. Shape law lives here; semantics in docs/aggregates-contract.md.",
  "properties": {
    "data_provenance": {
      "enum": [
        "synthetic",
        "production"
      ],
