              "$ref": "#/$defs/OkCell"
            },
            {
              "$ref": "#/$defs/SuppressedCell"
            }
          ],
          "title": "Cell"
        },
        "dow": {
          "maximum": 7,
          "minimum": 1,
          "title": "Dow",
          "type": "integer"
        },
        "hour": {
          "maximum": 23,
          "minimum": 0,
          "title": "Hour",
          "type": "integer"
        }
      },
      "required": [
        "dow",
        "hour",
        "cell"
      ],
      "title": "HeatmapCell",
      "type": "object"
    },
