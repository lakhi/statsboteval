# Copy to .env and pick ONE credential mode (never commit real values; .gitignore blocks .env*).

# --- local development against Azurite (npx --yes --package azurite azurite-blob --skipApiVersionCheck) ---
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true

# --- cloud: managed identity via DefaultAzureCredential (D-28; no secret in the app) ---
# STORAGE_ACCOUNT_URL=https://<account>.blob.core.windows.net

AGGREGATES_CONTAINER=aggregates
CACHE_TTL_SECONDS=300

# Serve the dashboard static export from this API (D-26); unset = API only.
# DASHBOARD_DIST=../dashboard/out

# Override where schema/aggregates.schema.json lives (set in the container image).
# SCHEMA_PATH=/app/schema/aggregates.schema.json
